generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FileCategory {
  LAB_REPORT
  PRESCRIPTION
  SCAN
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  isVerified   Boolean  @default(false)
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  healthRecord HealthRecord?
  files        RecordFile[]
  emailOtp     EmailOtp?
}

model EmailOtp {
  id          String   @id @default(uuid())
  userId      String   @unique
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id                    String     @id @default(uuid())
  userId                String     @unique
  age                   Int
  gender                Gender
  bloodGroup            BloodGroup
  heightCm              Float?
  weightKg              Float?
  allergies             String?
  chronicConditions     String?
  lastIllness           String?
  lastIllnessDate       DateTime?
  pastInjuries          String?
  currentMedications    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecordFile {
  id           String       @id @default(uuid())
  userId       String
  originalName String
  storedName   String       @unique
  mimeType     String
  sizeBytes    Int
  category     FileCategory @default(OTHER)
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
